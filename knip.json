{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreFiles": [".agents/skills/shadcn/**"],
  "workspaces": {
    ".": { "entry": ["scripts/smoke-web.mjs"] },
    "apps/api": { "entry": ["src/server.ts", "src/plugins/*.ts"] },
    "apps/web": { "entry": ["src/routes/**/*.{ts,tsx}", "src/features/brand/motion/src/scene.js"] },
    "apps/mobile": {
      "bun": { "entry": ["**/*.test.mjs"] },
      "ignoreDependencies": ["expo-updates"]
    },
    "tests/e2e": { "entry": ["fixtures/check.mjs", "fixtures/auth-preload.mjs"] }
  }
}
