{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreFiles": [".agents/skills/shadcn/**"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["husky"],
      "entry": [
        ".railway/gateway/smoke/upstreams.mjs",
        ".railway/gateway/smoke/test.mjs",
        ".railway/topology/smoke.mjs"
      ],
      "typescript": {
        "config": [".railway/tsconfig.json"]
      }
    },
    "apps/api": {
      "entry": ["src/server.ts", "src/plugins/*.ts"]
    },
    "apps/docs": {
      "entry": ["src/routes/**/*.{ts,tsx}", "scripts/search.test.ts"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "src/features/brand/motion/src/scene.js"]
    },
    "apps/mobile": {
      "bun": {
        "entry": ["**/*.test.mjs"]
      },
      "ignoreDependencies": ["expo-updates"]
    },
    "packages/i18n": {
      "entry": ["project.inlang/paraglide.config.ts"],
      "ignoreDependencies": ["@inlang/plugin-message-format"]
    },
    "scripts": {
      "entry": [
        "check/i18n-messages.ts",
        "smoke/{api-image,changed,compose,http-image,turbo,web}.ts"
      ],
      "bun": {
        "entry": ["**/*.test.{mjs,ts}"]
      }
    },
    "tests/e2e": {
      "entry": ["fixtures/check.mjs", "fixtures/auth-preload.mjs"]
    }
  }
}
