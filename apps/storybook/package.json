{
  "name": "storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --host 127.0.0.1 --port 6006 --exact-port --no-open --disable-telemetry",
    "build": "storybook build --output-dir dist --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "test:ui": "node scripts/test-addon-config.mjs && vitest run",
    "test:ui:install": "playwright install chromium --only-shell"
  },
  "dependencies": {
    "@kipivo/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@kipivo/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.1",
    "storybook": "10.6.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
