{
  "name": "storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "bun run --cwd ../../packages/i18n compile",
    "dev": "bun run compile && storybook dev --host 127.0.0.1 --port 6006 --exact-port --disable-telemetry",
    "build": "bun run compile && storybook build --output-dir dist --disable-telemetry",
    "preview": "vite preview --host 127.0.0.1 --port 6006 --strictPort",
    "test:stories": "bun run compile && vitest run",
    "test:ui": "playwright test",
    "ci:ui": "bun run test:stories && bun run test:ui",
    "test:ui:install": "playwright install chromium --only-shell",
    "typecheck": "bun run compile && tsc --noEmit"
  },
  "dependencies": {
    "@kipivo/icons": "workspace:*",
    "@kipivo/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@kipivo/tsconfig": "workspace:*",
    "@playwright/test": "1.65.1",
    "@storybook/addon-docs": "11.0.0-beta.3",
    "@storybook/addon-themes": "11.0.0-beta.3",
    "@storybook/addon-vitest": "11.0.0-beta.3",
    "@storybook/react-vite": "11.0.0-beta.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "storybook": "11.0.0-beta.3",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
