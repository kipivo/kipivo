{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "transit": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/assets/logo.svg",
        "!Dockerfile",
        "!src/routeTree.gen.ts"
      ]
    },
    "build": {
      "env": ["VITE_CLOUDFLARE_ANALYTICS_TOKEN", "VITE_UMAMI_WEBSITE_ID"],
      "inputs": ["$TURBO_EXTENDS$", ".env*", "!Dockerfile", "!src/routeTree.gen.ts"],
      "outputs": [".output/**", "src/routeTree.gen.ts"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!src/routeTree.gen.ts"],
      "outputs": ["src/routeTree.gen.ts"]
    }
  }
}
