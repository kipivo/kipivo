{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run paraglide:compile && vite dev --port 3000 --strictPort",
    "build": "bun run paraglide:compile && vite build",
    "start": "bun run ./.output/server/index.mjs",
    "paraglide:compile": "bun run --cwd ../../packages/i18n compile",
    "typecheck": "bun run paraglide:compile && bun scripts/generate-routes.mjs && tsc --noEmit",
    "test": "bun run paraglide:compile && vitest run"
  },
  "dependencies": {
    "@kipivo/admin": "workspace:*",
    "@kipivo/auth": "workspace:*",
    "@kipivo/contract": "workspace:*",
    "@kipivo/contracts": "workspace:*",
    "@kipivo/env": "workspace:*",
    "@kipivo/i18n": "workspace:*",
    "@kipivo/icons": "workspace:*",
    "@kipivo/orpc": "workspace:*",
    "@kipivo/rbac": "workspace:*",
    "@kipivo/runtime": "workspace:*",
    "@kipivo/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@kipivo/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "docs": "workspace:*",
    "nitro": "3.0.261103-rc",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
