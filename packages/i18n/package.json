{
  "name": "@kipivo/i18n",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./messages": "./generated/messages.js",
    "./runtime": "./generated/runtime.js",
    "./server": "./generated/server.js"
  },
  "scripts": {
    "compile": "paraglide-js compile --project ./project.inlang --outdir ./generated --silent",
    "typecheck": "bun run compile && tsc --noEmit",
    "test": "bun run compile && vitest run"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@kipivo/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
