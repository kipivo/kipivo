{
	admin off
	auto_https off
	persist_config off
}

# Railway terminates public TLS; the private listener accepts IPv4 and IPv6.
:{$PORT:8080} {
	# Route CSS is inlined into SSR HTML, so compress dynamic responses too.
	encode zstd gzip

	@gatewayHealth path /gateway-healthz
	handle @gatewayHealth {
		respond "ok" 200
	}

	@webAlias expression `{env.WEB_ALIAS_HOST} != "" && {http.request.host}.lowerAscii() == {env.WEB_ALIAS_HOST}.lowerAscii()`
	handle @webAlias {
		# Keep the AUTH_URL syntax in sync with packages/auth/src/env.ts.
		map {env.AUTH_URL} {canonicalOrigin} {
			~^([Hh][Tt][Tt][Pp][Ss]?://(?:[a-zA-Z0-9._-]+|\[[a-fA-F0-9:.]+\])(?::[0-9]+)?)/?$ ${1}
			default ""
		}

		@aliasPage {
			method GET HEAD
			not path /api /api/* /rpc /rpc/* /healthz /healthz/* /readyz /readyz/*
			expression `{canonicalOrigin} != ""`
		}
		handle @aliasPage {
			redir {canonicalOrigin}{uri} 308
		}
		handle {
			respond 404
		}
	}

	@local path /api/local /api/local/*
	handle @local {
		respond 404
	}

	@api path /rpc /rpc/* /api/auth /api/auth/* /api/v1 /api/v1/* /api/openapi.json /readyz
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}

	@docs {
		path /docs /docs/*
		expression `{env.DOCS_UPSTREAM} != ""`
	}
	handle @docs {
		reverse_proxy {$DOCS_UPSTREAM:127.0.0.1:4321} {
			header_up X-Forwarded-Proto https
			header_up -Cookie
			header_up -Authorization
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}
}
