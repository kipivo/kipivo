{
  "name": "kipivo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "bun run --filter web start",
    "typecheck": "turbo run typecheck && tsc -p .railway/tsconfig.json",
    "test": "turbo run test",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "railway": "3.17.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "bun@1.4.3"
}
