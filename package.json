{
  "name": "kipivo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests/*",
      "scripts"
    ],
    "catalog": {
      "@vitest/browser-playwright": "5.1.0",
      "@vitest/coverage-v8": "5.1.0",
      "citty": "0.1.6",
      "hono": "5.0.0-rc.1",
      "oxlint": "1.94.0",
      "vite": "8.3.8",
      "vitest": "5.1.0",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=!storybook",
    "dev:api": "bun run --cwd apps/api serve",
    "dev:docs": "bun run --cwd apps/docs dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:storybook": "bun run --cwd apps/storybook dev",
    "build:storybook": "turbo run build --filter=storybook",
    "test:stories": "bun run --cwd apps/storybook test:stories",
    "test:ui": "bun run --cwd apps/storybook test:ui",
    "test:ui:install": "bun run --cwd apps/storybook test:ui:install",
    "ui:add": "bun run --cwd packages/ui ui:add",
    "kipivo": "bun ./apps/cli/src/index.ts",
    "kpvo": "bun ./apps/cli/src/index.ts",
    "build": "turbo run build",
    "start": "bun run --filter web start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run build --filter=api --filter=kipivo && bun run --cwd tests/e2e test:e2e --project=api --project=chromium",
    "test:e2e:all": "bash tests/e2e/run-all.sh",
    "test:e2e:install": "bun run --cwd tests/e2e playwright install chromium",
    "test:auth": "turbo run build --filter=web --filter=api && bun run --cwd tests/e2e test:e2e --project=auth",
    "test:resources": "turbo run build --filter=api && bun run --cwd tests/e2e test:e2e --project=resources",
    "db:generate": "bun run --cwd packages/db generate",
    "db:check": "bun run --cwd packages/db schema:check",
    "db:migrate": "bun run --cwd apps/api scripts/db.ts db:migrate",
    "knip": "knip",
    "prepare": "if [ -x node_modules/.bin/kpdev ]; then kpdev i18n compile --if-installed; fi && if [ -e .git ] && [ -z \"$CI\" ] && [ -x node_modules/.bin/husky ]; then husky; fi",
    "commitlint": "kpdev commit lint",
    "lint": "oxlint --deny-warnings . && bun run --cwd scripts lint:test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "kpdev check",
    "ci:plan": "kpdev ci plan",
    "ci:test": "kpdev ci test"
  },
  "devDependencies": {
    "@kipivo/tsconfig": "workspace:*",
    "husky": "9.1.7",
    "knip": "6.45.1",
    "kpdev": "workspace:*",
    "oxfmt": "0.79.0",
    "oxlint": "catalog:",
    "railway": "3.17.0",
    "turbo": "2.11.12",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
