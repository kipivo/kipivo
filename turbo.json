{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["bunfig.toml", "mise.toml", "mise.lock"],
  "futureFlags": { "affectedUsingTaskInputs": true },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [".output/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^typecheck"]
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
