{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["assets/logo.svg", ".node-version"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**", "src/routeTree.gen.ts"]
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "test": {}
  }
}
