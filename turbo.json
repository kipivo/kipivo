{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["assets/logo.svg", ".node-version"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": [".output/**", "dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build", "transit", "generate:routes"],
      "outputs": [".output/**"]
    },
    "generate:routes": {
      "dependsOn": ["transit"],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^typecheck"]
    },
    "web#typecheck": {
      "dependsOn": ["transit", "^typecheck", "generate:routes"]
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
