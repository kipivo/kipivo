{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["assets/logo.svg", "bunfig.toml"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": [".output/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^typecheck"]
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
